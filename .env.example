# Application
APP_NAME=NEXUS AI
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

# Security — generate a strong random value for production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (used from Phase 2 onward)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1000000

# LLM providers (optional in Phase 1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
